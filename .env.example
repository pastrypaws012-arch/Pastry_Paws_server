# Pastry Paws Backend Environment Configuration

# Server Port
PORT=5000

# MongoDB Atlas Connection URI
# Replace with your connection string from MongoDB Atlas:
# mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/pastry_paws?retryWrites=true&w=majority
MONGODB_URI=

# Google Drive API Configuration (Service Account)
# Created from Google Cloud Console > Service Accounts > Keys (JSON)
GOOGLE_DRIVE_CLIENT_EMAIL=
GOOGLE_DRIVE_PRIVATE_KEY=
# The Google Drive Folder ID where images should be saved (from folder URL: drive.google.com/drive/folders/<FOLDER_ID>)
GOOGLE_DRIVE_FOLDER_ID=

# Admin Dashboard Access (Optional PIN / Secret)
ADMIN_SECRET_KEY=pastrypawsadmin2026
