# Pastry Paws Backend Environment Configuration

# Server Port
PORT=5000

# MongoDB Atlas Connection URI
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/pastry_paws?retryWrites=true&w=majority
MONGODB_URI=

# Cloudinary Image Storage & CDN (Free 25GB)
# Get from your Cloudinary Dashboard: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=PastryPaws

# Admin Dashboard Access Secret
ADMIN_SECRET_KEY=pastrypawsadmin2026
